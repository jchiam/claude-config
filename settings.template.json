{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.ai.tech.gov.sg/platform/models",
    "CLAUDE_CODE_USE_BEDROCK": "0",
    "CLAUDE_CODE_USE_FOUNDRY": "0",
    "CLAUDE_CODE_USE_MANTLE": "0",
    "CLAUDE_CODE_USE_VERTEX": "0",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "bedrock.claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "bedrock.claude-sonnet-4-6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "bedrock.claude-opus-4-6",
    "ANTHROPIC_CUSTOM_MODEL_OPTION": "bedrock.claude-sonnet-4-5",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_NAME": "Sonnet 4.5",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION": "Sonnet 4.5 · Alternative if encountering rate limits on Sonnet 4.6"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:unpkg.com)",
      "WebFetch(domain:app.unpkg.com)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "Bash(git -C *)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(npm list:*)",
      "Bash(npm show:*)",
      "Bash(npm run:*)",
      "Bash(gh auth:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr:*)",
      "Edit(~/.claude/skills/**)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(curl * | bash)",
      "Bash(npx:*)"
    ],
    "ask": [
      "Edit(~/.claude/settings.json)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "Read(**/.aws/**)",
      "Edit(**/.aws/**)",
      "Read(**/.gcp/**)",
      "Edit(**/.gcp/**)",
      "Read(**/.azure/**)",
      "Edit(**/.azure/**)",
      "Read(**/.ssh/*)",
      "Edit(**/.ssh/*)",
      "Read(**/id_rsa*)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "modelOverrides": {
    "claude-haiku-4-5-20251001": "bedrock.claude-haiku-4-5",
    "claude-sonnet-4-5-20250929": "bedrock.claude-sonnet-4-5",
    "claude-sonnet-4-6": "bedrock.claude-sonnet-4-6",
    "claude-opus-4-5-20251101": "bedrock.claude-opus-4-5",
    "claude-opus-4-6": "bedrock.claude-opus-4-6"
  },
  "enableAllProjectMcpServers": false,
  "allowedMcpServers": [],
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "sandbox": {
    "filesystem": {}
  },
  "effortLevel": "medium",
  "companyAnnouncements": [
    "Claude Code managed by GovTech - https://go.gov.sg/gt-cc-managed-settings"
  ]
}
